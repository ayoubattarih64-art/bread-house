# ─────────────────────────────────────────────
# Bread House — متغيرات البيئة
# انسخ هذا الملف إلى .env.local واملأ القيم الحقيقية.
# ملاحظة: .env.local لا يُرفع إلى Git (محمي عبر .gitignore).
# ─────────────────────────────────────────────

# الرابط العام للموقع (يُستخدم في metadata / sitemap / robots / JSON-LD)
NEXT_PUBLIC_SITE_URL=https://breadhouse-morocco.com

# ── إعدادات EmailJS (server-only — لا تُكشف في المتصفح) ──
# تُستخدم فقط داخل /app/api/contact/route.ts
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# المفتاح الخاص مطلوب لتفعيل الإرسال من السيرفر (Strict Mode في EmailJS)
EMAILJS_PRIVATE_KEY=
